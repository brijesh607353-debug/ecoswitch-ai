# =============================================================================
# EcoSwitch AI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials.
#
#   cp .env.example .env.local
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the API server listens on (default: 5000)
PORT=5000

# Node environment: development | test | production
NODE_ENV=development

# Secret used to sign session tokens — generate with: openssl rand -hex 32
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Full Postgres connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# -----------------------------------------------------------------------------
# Firebase (if used)
# -----------------------------------------------------------------------------

# Firebase project settings — find these in your Firebase console
# Project Settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only — NEVER expose publicly)
# Base64-encode the JSON key file: base64 -i service-account.json
FIREBASE_ADMIN_CREDENTIAL=

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional: External services
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking — https://sentry.io
SENTRY_DSN=

# Base URL of the deployed API (used by the frontend in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
